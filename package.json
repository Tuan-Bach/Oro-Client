{
  "name": "oro-assistant",
  "version": "0.2.0",
  "description": "Oro — AI Agents & All-in-One Second Brain Workspace",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:ui": "vite",
    "build:ui": "vite build",
    "build": "tsc && vite build",
    "tauri:build": "tauri build",
    "tauri:release": "npm run build:ui && tauri build --no-bundle",
    "test": "cargo run --manifest-path src-tauri/Cargo.toml --bin test_coworker",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "lucide-react": "^1.75.0",
    "marked": "^18.2.1",
    "react": "^19.3.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.8.0",
    "vite": "^8.3.8"
  }
}
