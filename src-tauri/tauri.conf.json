{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "oro",
  "version": "0.1.0",
  "identifier": "com.oro.desktop",
  "build": {
    "frontendDist": "../dist/renderer",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:ui",
    "beforeBuildCommand": "npm run build:ui"
  },
  "app": {
    "windows": [
      {
        "title": "Oro — AI Second Brain",
        "width": 1440,
        "height": 920,
        "minWidth": 640,
        "minHeight": 450,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "shadow": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
